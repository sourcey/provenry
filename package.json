{
  "name": "provenry",
  "version": "0.1.5",
  "description": "The facts and provenance engine behind Sourcey. Gives published facts a history anyone can verify from the files alone.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourcey/provenry.git"
  },
  "homepage": "https://github.com/sourcey/provenry#readme",
  "bugs": "https://github.com/sourcey/provenry/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "provenance",
    "attestation",
    "verifiable-records",
    "publication",
    "canonical-json",
    "ed25519",
    "sourcey"
  ],
  "packageManager": "npm@11.19.1",
  "files": [
    "dist/modules",
    "dist/contracts",
    "modules",
    "contracts",
    "examples",
    "FORMAT.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "./primitives": {
      "types": "./dist/modules/primitives/src/index.d.ts",
      "import": "./dist/modules/primitives/src/index.js"
    },
    "./identity": {
      "types": "./dist/modules/identity/src/index.d.ts",
      "import": "./dist/modules/identity/src/index.js"
    },
    "./git": {
      "types": "./dist/modules/git/src/index.d.ts",
      "import": "./dist/modules/git/src/index.js"
    },
    "./records/references": {
      "types": "./dist/modules/records/src/references.d.ts",
      "import": "./dist/modules/records/src/references.js"
    },
    "./capture/attempts": {
      "types": "./dist/modules/capture/src/attempts.d.ts",
      "import": "./dist/modules/capture/src/attempts.js"
    },
    "./capture/attestation": {
      "types": "./dist/modules/capture/src/attestation.d.ts",
      "import": "./dist/modules/capture/src/attestation.js"
    },
    "./capture/methods": {
      "types": "./dist/modules/capture/src/methods.d.ts",
      "import": "./dist/modules/capture/src/methods.js"
    },
    "./capture/start": {
      "types": "./dist/modules/capture/src/start.d.ts",
      "import": "./dist/modules/capture/src/start.js"
    },
    "./publication/changes": {
      "types": "./dist/modules/publication/src/changes.d.ts",
      "import": "./dist/modules/publication/src/changes.js"
    },
    "./publication/delivery": {
      "types": "./dist/modules/publication/src/delivery.d.ts",
      "import": "./dist/modules/publication/src/delivery.js"
    },
    "./publication/envelope": {
      "types": "./dist/modules/publication/src/envelope.d.ts",
      "import": "./dist/modules/publication/src/envelope.js"
    },
    "./publication/preparation": {
      "types": "./dist/modules/publication/src/preparation.d.ts",
      "import": "./dist/modules/publication/src/preparation.js"
    },
    "./publication/objects": {
      "types": "./dist/modules/publication/src/objects.d.ts",
      "import": "./dist/modules/publication/src/objects.js"
    },
    "./publication/projection-shards": {
      "types": "./dist/modules/publication/src/projection-shards.d.ts",
      "import": "./dist/modules/publication/src/projection-shards.js"
    },
    "./publication/projection-snapshot": {
      "types": "./dist/modules/publication/src/projection-snapshot.d.ts",
      "import": "./dist/modules/publication/src/projection-snapshot.js"
    },
    "./publication/dataset-features": {
      "types": "./dist/modules/publication/src/dataset-features.d.ts",
      "import": "./dist/modules/publication/src/dataset-features.js"
    },
    "./contracts/publication": {
      "types": "./dist/contracts/publication/src/index.d.ts",
      "import": "./dist/contracts/publication/src/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "biome check .",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && node scripts/check-exports.mjs && node scripts/check-package.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
